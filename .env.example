# --- 镜像 --------------------------------------------------------------------
# 运行用的镜像。默认拉 CI 构建的 rc 系列；换加速源或指向本地构建的 tag
# （如 deepseek-harness:local）只改这一行。本地构建参数见 README。
DSH_IMAGE=ghcr.io/zuziceng/dsh-docker/deepseek-harness:rc

# --- 运行时（可选） ----------------------------------------------------------
# Caddy 已把上游 Host 统一改写为 127.0.0.1:3080，cookie 与信任围栏都按该值对齐，
# 局域网任意 IP/域名都能访问，这两项正常留空。仅在绕过 Caddy 直连应用时按实际
# 访问地址设置：
#   PUBLIC_URL=https://<局域网IP>:3080/
#   TRUSTED_HOSTS=<局域网IP>
PUBLIC_URL=
TRUSTED_HOSTS=

# --- 局域网 HTTPS 入口（Caddy 默认随栈启动） ----------------------------------
# LAN_HOST 必填：局域网 IP 或域名，会写进证书 SAN 与 Caddy 站点地址。
# ET_HOST 是第二入口（如外网穿透地址），留空 = 只服务局域网。
# 两项会签进同一张证书，所以可以填两个地址同时用。
LAN_HOST=
ET_HOST=
LAN_PORT=3080

# --- 传给 custom-scripts 的变量 ------------------------------------------------
# 每次启动自动补装的 apt 包（10-apt-packages.sh；空格分隔，已装自动跳过）。
# 镜像只内置 dsh 运行必需项（Node/Python/git/bubblewrap/socat/tini/jq/curl）。
EXTRA_APT_PACKAGES=build-essential pkg-config ripgrep tmux openssh-client unzip zip file less procps psmisc xz-utils
# 启动时安装的 Python 包（20-pip-packages.sh；空格分隔），例：requests httpx rich
PIP_PACKAGES=

# --- 软件源镜像（05-mirrors.sh 读取） ------------------------------------------
# 容器启动时把 apt / npm / pip 源换成国内镜像；设为空字符串则跳过该类改写。
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
NPM_MIRROR=https://registry.npmmirror.com
PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 时区 -------------------------------------------------------------------
TZ=Asia/Shanghai
